# =================================================================
# Zylo Realtime Messaging Application - Environment Configuration
# =================================================================
# Copy this file to .env and customize values for your deployment.

# Application Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/zylo
MONGODB_USER=
MONGODB_PASSWORD=

# Redis Cache & Live Presence
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Session Expiry
# WARNING: Generate strong random secrets (min 32 characters) for production!
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRATION=7d

# File Upload & Media Storage (local or cloudinary)
UPLOAD_DRIVER=local
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE_BYTES=26214400 # 25MB

# Cloudinary CDN (Required in production for public asset URLs)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Cloud Messaging (Push Notifications for background devices)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
