# ==============================================
# Zylo Messaging Application - Environment Variables
# ==============================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/zylo
MONGODB_USER=
MONGODB_PASSWORD=

# Redis Cache & Presence
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=zylo_super_secret_jwt_access_key_change_in_production_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=zylo_super_secret_jwt_refresh_key_change_in_production_67890
JWT_REFRESH_EXPIRATION=7d

# File Upload & Media Storage
UPLOAD_DRIVER=local
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE_BYTES=26214400 # 25MB
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
